package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_prebuilt_binary {
    name: "stats-log-api-gen",
    srcs: ["bin/stats-log-api-gen"],
    prefer: true,
    host_supported: true,
    device_supported: false,
}

cc_prebuilt_binary {
    name: "expresscatalog-codegen",
    srcs: ["bin/expresscatalog-codegen"],
    prefer: true,
    host_supported: true,
    device_supported: false,
}

cc_prebuilt_library_shared {
    name: "libstats_proto_host",
    srcs: ["lib64/libstats_proto_host.so"],
    prefer: true,
    host_supported: true,
    device_supported: false,
}

cc_prebuilt_library_shared {
    name: "libexpressconfig_proto_host",
    srcs: ["lib64/libexpressconfig_proto_host.so"],
    prefer: true,
    host_supported: true,
    device_supported: false,
}

cc_prebuilt_library_shared {
    name: "libexpresscatalog",
    srcs: ["lib64/libexpresscatalog.so"],
    prefer: true,
    host_supported: true,
    device_supported: false,
    export_include_dirs: ["include"],
}

cc_prebuilt_library_headers {
    name: "libexpresscatalog-utils-headers",
    prefer: true,
    export_include_dirs: ["include"],
    host_supported: true,
}
